# Inspect model (identical across arms)
INSPECT_EVAL_MODEL=openai/gpt-4o-mini

# Model provider credentials (Inspect reads these directly)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional web-search fallbacks when the model has no built-in search
TAVILY_API_KEY=
# GOOGLE_CSE_ID=
# GOOGLE_CSE_API_KEY=

# Cala hosted MCP (required for the Cala arm; never commit the real key)
CALA_API_KEY=
